# Copy to `.env` for local development (`.env` is git-ignored).
# In production these are provided as GitHub Actions secrets (see docs/SETUP.md).

# --- Public keys (end up in the client bundle; restrict by domain in each console) ---
PUBLIC_KAKAO_JS_KEY=

# --- Private values (build-time only, never commit real values) ---
PHONE_DAD=010-0000-0000
PHONE_MOM=010-0000-0000
