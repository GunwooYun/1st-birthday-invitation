---
import SectionTitle from './SectionTitle.astro';
import { invitation } from '../config/invitation';

const { event } = invitation;
const eventDate = new Date(event.startAt);
// Calendar is rendered for the event month in KST.
const KST_OFFSET_MS = 9 * 60 * 60 * 1000;
const kst = new Date(eventDate.getTime() + KST_OFFSET_MS);
const year = kst.getUTCFullYear();
const month = kst.getUTCMonth();
const eventDay = kst.getUTCDate();

const firstWeekday = new Date(Date.UTC(year, month, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const cells: (number | null)[] = [
  ...Array(firstWeekday).fill(null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
while (cells.length % 7 !== 0) cells.push(null);
const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];
---

<section class="section reveal">
  <SectionTitle eyebrow="Save the Date" title={`${year}년 ${month + 1}월`} />
  <p class="calendar__label">{event.dateLabel} {event.timeLabel}</p>
  <div class="calendar card" role="table" aria-label="행사 날짜 달력">
    <div class="calendar__row calendar__row--head" role="row">
      {
        WEEKDAYS.map((d, i) => (
          <span role="columnheader" class:list={{ 'is-sunday': i === 0 }}>
            {d}
          </span>
        ))
      }
    </div>
    {
      Array.from({ length: cells.length / 7 }, (_, week) => (
        <div class="calendar__row" role="row">
          {cells.slice(week * 7, week * 7 + 7).map((day, i) => (
            <span role="cell" class:list={{ 'is-sunday': i === 0, 'is-event': day === eventDay }}>
              {day ?? ''}
            </span>
          ))}
        </div>
      ))
    }
  </div>
  <p class="calendar__dday">
    소은이의 첫 생일까지 <strong data-dday={event.startAt}>D-?</strong>
  </p>
</section>

<style>
  .calendar__label {
    margin: -12px 0 20px;
    color: var(--muted);
    font-size: 14px;
  }
  .calendar {
    padding: 16px 12px;
  }
  .calendar__row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
  }
  .calendar__row span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    font-size: 14px;
  }
  .calendar__row--head span {
    color: var(--muted);
    font-size: 12px;
    height: 28px;
  }
  .is-sunday {
    color: var(--accent-deep);
  }
  .is-event {
    position: relative;
    isolation: isolate;
    color: #fff;
    font-weight: 700;
  }
  .is-event::before {
    content: '';
    position: absolute;
    inset: 4px;
    margin: auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    z-index: -1;
  }
  .calendar__dday {
    margin: 24px 0 0;
    font-size: 15px;
  }
  .calendar__dday strong {
    display: inline-block;
    margin-left: 6px;
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
</style>
