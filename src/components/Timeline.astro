---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from './SectionTitle.astro';
import { invitation } from '../config/invitation';
import birth from '../assets/photos/timeline-birth.jpg';
import hundred from '../assets/photos/timeline-100.jpg';
import first from '../assets/photos/timeline-first.jpg';

const images: Record<string, ImageMetadata> = { birth, hundred, first };
---

<section class="section section--tint reveal">
  <SectionTitle eyebrow="Growing Up" title="소은이의 일 년" />
  <ol class="timeline">
    {
      invitation.timeline.map((entry) => (
        <li class="timeline__item">
          <Picture
            src={images[entry.id]}
            formats={['webp']}
            widths={[320, 640]}
            sizes="(max-width: 430px) 30vw, 130px"
            alt={`${entry.label} 사진`}
            class="timeline__img"
          />
          <p class="timeline__label">{entry.label}</p>
          <p class="timeline__date">{entry.date}</p>
          <p class="timeline__caption">{entry.caption}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .timeline__item {
    text-align: center;
  }
  .timeline__item :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--sage-soft);
  }
  .timeline__label {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: 16px;
  }
  .timeline__date,
  .timeline__caption {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }
</style>
