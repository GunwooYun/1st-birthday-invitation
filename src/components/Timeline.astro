---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from './SectionTitle.astro';
import { invitation } from '../config/invitation';
import birth from '../assets/photos/timeline-birth.jpg';
import hundred from '../assets/photos/timeline-100.jpg';
import first from '../assets/photos/timeline-first.jpg';

const LIGHTBOX_MAX_WIDTH = 1080;
const images: Record<string, ImageMetadata> = { birth, hundred, first };
const fullSizes = Object.fromEntries(
  await Promise.all(
    Object.entries(images).map(async ([id, image]) => [
      id,
      await getImage({ src: image, format: 'webp', width: Math.min(LIGHTBOX_MAX_WIDTH, image.width) }),
    ]),
  ),
) as Record<string, Awaited<ReturnType<typeof getImage>>>;
---

<section class="section section--tint reveal">
  <SectionTitle eyebrow="Growing Up" title="소은이의 일년" />
  <ol class="timeline" data-lightbox>
    {
      invitation.timeline.map((entry) => (
        <li class="timeline__item">
          <a
            class="timeline__link"
            href={fullSizes[entry.id]!.src}
            data-pswp-width={fullSizes[entry.id]!.attributes.width}
            data-pswp-height={fullSizes[entry.id]!.attributes.height}
            target="_blank"
            rel="noreferrer"
            aria-label={`${entry.label} 사진 크게 보기`}
          >
            <Picture
              src={images[entry.id]}
              formats={['webp']}
              widths={[320, 640]}
              sizes="(max-width: 430px) 30vw, 130px"
              alt={`${entry.label} 사진`}
              class="timeline__img"
            />
          </a>
          <p class="timeline__label">{entry.label}</p>
          <p class="timeline__date">{entry.date}</p>
          <p class="timeline__caption">{entry.caption}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .timeline__item {
    text-align: center;
  }
  .timeline__link {
    display: block;
  }
  .timeline__item :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--sage-soft);
  }
  .timeline__label {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: 16px;
  }
  .timeline__date,
  .timeline__caption {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }
</style>
