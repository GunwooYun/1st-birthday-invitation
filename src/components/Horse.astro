---
// Cute chibi horse mascot (the baby was born in 2026, the Year of the Horse).
// Pure inline SVG so it scales crisply and needs no extra request.
interface Props {
  size?: number;
  variant?: 'plain' | 'party' | 'balloon';
  flip?: boolean;
  class?: string;
}
const { size = 120, variant = 'plain', flip = false, class: className } = Astro.props;
const uid = `h${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['horse', className]}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="아기 말 캐릭터"
  style={flip ? 'transform: scaleX(-1)' : undefined}
>
  <defs>
    <clipPath id={`${uid}-tummy`}>
      <ellipse cx="100" cy="150" rx="50" ry="34"></ellipse>
    </clipPath>
  </defs>

  {
    variant === 'balloon' && (
      <g class="horse__balloon">
        <path
          d="M148 96 C 150 80, 158 66, 166 52"
          fill="none"
          stroke="#c9a893"
          stroke-width="2"
          stroke-linecap="round"
        />
        <ellipse cx="168" cy="36" rx="18" ry="22" fill="#f7b7c3" />
        <path d="M164 56 l4 4 l4 -4 z" fill="#f7b7c3" />
        <text x="168" y="43" text-anchor="middle" font-family="Gowun Dodum, sans-serif" font-size="20" fill="#ffffff">
          1
        </text>
      </g>
    )
  }

  <!-- tail -->
  <path d="M40 132 C 22 128, 18 150, 30 160 C 24 148, 34 138, 44 142 Z" fill="#c9a893"></path>

  <!-- body -->
  <ellipse cx="100" cy="150" rx="50" ry="34" fill="#f8d9c6"></ellipse>
  <ellipse cx="100" cy="164" rx="34" ry="18" fill="#fff1e8" clip-path={`url(#${uid}-tummy)`}></ellipse>

  <!-- legs (two, slightly apart) -->
  <rect x="72" y="166" width="18" height="26" rx="9" fill="#f8d9c6"></rect>
  <rect x="110" y="166" width="18" height="26" rx="9" fill="#f8d9c6"></rect>
  <rect x="72" y="184" width="18" height="8" rx="4" fill="#c9a893"></rect>
  <rect x="110" y="184" width="18" height="8" rx="4" fill="#c9a893"></rect>

  <!-- ears -->
  <path d="M60 70 C 52 44, 70 40, 76 62 Z" fill="#f8d9c6"></path>
  <path d="M63 66 C 59 52, 68 48, 71 62 Z" fill="#f7b7c3"></path>
  <path d="M140 70 C 148 44, 130 40, 124 62 Z" fill="#f8d9c6"></path>
  <path d="M137 66 C 141 52, 132 48, 129 62 Z" fill="#f7b7c3"></path>

  <!-- head -->
  <ellipse cx="100" cy="96" rx="54" ry="48" fill="#f8d9c6"></ellipse>

  <!-- mane -->
  <path
    d="M52 78 C 50 58, 66 46, 82 54 C 92 42, 112 42, 120 54 C 136 46, 152 58, 148 78 C 140 66, 128 64, 118 70 C 110 60, 92 60, 84 70 C 72 62, 60 66, 52 78 Z"
    fill="#c9a893"></path>
  <path d="M84 62 C 90 50, 104 50, 110 62 C 104 58, 92 58, 84 62 Z" fill="#b48b74"></path>

  <!-- muzzle -->
  <ellipse cx="100" cy="116" rx="30" ry="20" fill="#fff1e8"></ellipse>
  <ellipse cx="90" cy="118" rx="4" ry="3" fill="#b48b74"></ellipse>
  <ellipse cx="110" cy="118" rx="4" ry="3" fill="#b48b74"></ellipse>
  <path d="M92 128 Q 100 134 108 128" fill="none" stroke="#b48b74" stroke-width="2.5" stroke-linecap="round"></path>

  <!-- eyes -->
  <circle cx="78" cy="98" r="6" fill="#4b3f3a"></circle>
  <circle cx="80" cy="96" r="2" fill="#ffffff"></circle>
  <circle cx="122" cy="98" r="6" fill="#4b3f3a"></circle>
  <circle cx="124" cy="96" r="2" fill="#ffffff"></circle>

  <!-- cheeks -->
  <circle cx="64" cy="110" r="7" fill="#f7b7c3" opacity="0.8"></circle>
  <circle cx="136" cy="110" r="7" fill="#f7b7c3" opacity="0.8"></circle>

  {
    variant === 'party' && (
      <g class="horse__hat">
        <path d="M100 18 L 84 58 L 116 58 Z" fill="#b7d9c4" />
        <path d="M92 38 L 108 38 L 104 48 L 96 48 Z" fill="#ffffff" opacity="0.6" />
        <circle cx="100" cy="18" r="5" fill="#f7b7c3" />
      </g>
    )
  }
</svg>

<style>
  .horse {
    display: block;
    overflow: visible;
  }
</style>
