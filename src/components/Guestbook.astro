---
import SectionTitle from './SectionTitle.astro';

const NAME_MAX = 20;
const MESSAGE_MAX = 200;
---

<section class="section section--tint reveal" data-guestbook>
  <SectionTitle eyebrow="Guestbook" title="축하 한마디" />
  <p class="section__lead">{'소은이에게 전하고 싶은\n따뜻한 한마디를 남겨 주세요.'}</p>
  <form class="guestbook__form card" autocomplete="off">
    <label class="visually-hidden" for="guestbook-name">이름</label>
    <input class="input" id="guestbook-name" name="name" placeholder="이름" maxlength={NAME_MAX} required />
    <label class="visually-hidden" for="guestbook-message">메시지</label>
    <textarea
      class="input"
      id="guestbook-message"
      name="message"
      placeholder="축하 메시지"
      rows="3"
      maxlength={MESSAGE_MAX}
      required></textarea>
    <button class="btn btn--primary btn--block" type="submit">메시지 남기기</button>
  </form>
  <ul class="guestbook__list" data-guestbook-list>
    <li class="guestbook__empty">메시지를 불러오는 중…</li>
  </ul>
</section>

<style>
  .guestbook__form {
    display: grid;
    gap: 10px;
  }
  .guestbook__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    text-align: left;
  }
  .guestbook__list :global(.guestbook__item) {
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .guestbook__list :global(.guestbook__message) {
    margin: 0 0 8px;
    font-size: 14px;
    white-space: pre-line;
  }
  .guestbook__list :global(.guestbook__meta) {
    margin: 0;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
  }
  .guestbook__list :global(.guestbook__empty) {
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }
</style>
