rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules  (or paste into Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Guestbook: anyone signed in (anonymously) may read and create; nobody may edit or delete.
    match /guestbook/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'createdAt'])
        && isString(request.resource.data.name, 20)
        && isString(request.resource.data.message, 200)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Doljabi poll: one vote per anonymous uid (doc id == uid), immutable once cast.
    match /doljabi_votes/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['item', 'createdAt'])
        && request.resource.data.item in ['thread', 'money', 'pencil', 'stethoscope', 'mic', 'gavel', 'ball']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
